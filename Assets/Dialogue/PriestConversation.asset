  autoAcceptQuest: {fileID: 11400000, guid: cc264f697565ede4db93d147a118d1e6, type: 2}
  autoAcceptedStartNodeId: offer
  autoTurnInQuests:
  - {fileID: 11400000, guid: cc264f697565ede4db93d147a118d1e6, type: 2}
  entryRules:
  - encounterId: 
    mustBeDefeated: 1
    quest: {fileID: 11400000, guid: cc264f697565ede4db93d147a118d1e6, type: 2}
