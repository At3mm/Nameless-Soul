  m_EditorClassIdentifier: Assembly-CSharp::World.NpcInteractable
  interactionRadius: 1.5
  interactionLabel: "N\xF3i chuy\u1EC7n v\u1EDBi tu s\u0129"
  interactionPoint: {fileID: 0}
  dialogue: {fileID: 11400000, guid: 18d42014fa9b62746a302756f9dc8a97, type: 2}
  displayName: "Tu s\u0129"
  dialogueLines:
  - "Ch\xE0o ng\u01B0\u1EDDi l\u1EEF h\xE0nh. Mong b\xECnh an lu\xF4n \u0111\u1ED3ng
    h\xE0nh c\xF9ng ng\u01B0\u01A1i."
  - "Ta c\xF3 nh\u1EEFng v\u1EADt ph\u1EA9m gi\xFAp ng\u01B0\u01A1i chu\u1EA9n b\u1ECB
    cho h\xE0nh tr\xECnh. H\xE3y xem qua n\u1EBFu c\u1EA7n."
  dialogueFont: {fileID: 12800000, guid: b7a06ccccedd1b84c9dc3ba41db98785, type: 3}
  panelSprite: {fileID: 21300000, guid: 7e390d2ef7c03cf42ab65777c592cb73, type: 2}
