"travel" -> "shrine" [style=dashed, arrowhead=vee, constraint=false, xlabel="«extend»"];
"pray" -> "restore" [style=dashed, arrowhead=vee, label="«include»"];
"pray" -> "respawn" [style=dashed, arrowhead=vee, label="«include»"];
"upgrade" -> "payexp" [style=dashed, arrowhead=vee, label="«include»"];
"seed" -> "payseed" [style=dashed, arrowhead=vee, label="«include»"];
"purify" -> "payincense" [style=dashed, arrowhead=vee, label="«include»"];
"travel" -> "unlocked" [style=dashed, arrowhead=vee, label="«include»"];
"shrine" -> "pray" [style=invis, weight=8];
"shrine" -> "upgrade" [style=invis, weight=8];
"shrine" -> "seed" [style=invis, weight=8];
"shrine" -> "purify" [style=invis, weight=8];
"shrine" -> "travel" [style=invis, weight=8];
}