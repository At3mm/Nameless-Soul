digraph UML { graph [rankdir=TB, bgcolor="white", fontname="Arial", fontsize=19, label="Hình 6. Class Diagram — checkpoint, kinh tế và lưu game", labelloc=t, pad="0.28", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst, ordering=out]; node [fontname="Arial", fontsize=13, color="#263442"]; edge [fontname="Arial", fontsize=10, color="#526170", arrowsize=.7];
"cp" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«WorldInteractable subclass»</FONT><BR/><B>World.CheckpointInteractable</B></TD></TR><TR><TD ALIGN="LEFT">+checkpointId: string<BR ALIGN="LEFT"/>+RespawnPosition: Vector3<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">#Interact(player)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"menu" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>World.CheckpointMenu</B></TD></TR><TR><TD ALIGN="LEFT">+checkpointName: string<BR ALIGN="LEFT"/>+CurrentSection: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+Pray()<BR ALIGN="LEFT"/>+TravelToSelected()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"service" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«singleton MonoBehaviour»</FONT><BR/><B>World.CheckpointService</B></TD></TR><TR><TD ALIGN="LEFT">-[static] instance: CheckpointService<BR ALIGN="LEFT"/>+[static] SavedChanged: event<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+[static] Save(...)<BR ALIGN="LEFT"/>+[static] TravelTo(...)<BR ALIGN="LEFT"/>+[static] ReturnToLastShrine(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"record" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«Serializable»</FONT><BR/><B>CheckpointService.Record</B></TD></TR><TR><TD ALIGN="LEFT">+scenePath / checkpointId: string<BR ALIGN="LEFT"/>+returnScenePath / returnCheckpointId<BR ALIGN="LEFT"/>+x / y / z: float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"fade" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«singleton MonoBehaviour»</FONT><BR/><B>World.ScreenFader</B></TD></TR><TR><TD ALIGN="LEFT">+FadeOut(...) / FadeIn(...)<BR ALIGN="LEFT"/>+TransitionToScene(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"respawn" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«static service»</FONT><BR/><B>World.NormalEnemyRespawns</B></TD></TR><TR><TD ALIGN="LEFT">+[static] Register(...)<BR ALIGN="LEFT"/>+[static] ResetNormals(scene)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"eco" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«static service»</FONT><BR/><B>GameEconomy</B></TD></TR><TR><TD ALIGN="LEFT">+[static] Gold / Experience / LifeSeeds<BR ALIGN="LEFT"/>+[static] Changed: event<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+[static] TryUpgrade(stat)<BR ALIGN="LEFT"/>+[static] SacrificeLifeSeed(potion)<BR ALIGN="LEFT"/>+[static] PurifySoulConsumption()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"settings" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«ScriptableObject»</FONT><BR/><B>EconomySettings</B></TD></TR><TR><TD ALIGN="LEFT">+UpgradeCost(purchaseCount)<BR ALIGN="LEFT"/>+Rewards(type, ...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"prog" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>PlayerProgression</B></TD></TR><TR><TD ALIGN="LEFT">+GrantGold(amount)<BR ALIGN="LEFT"/>+GrantExperience(amount)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"potion" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>PlayerHealthPotion</B></TD></TR><TR><TD ALIGN="LEFT">+StartingCapacity = 3<BR ALIGN="LEFT"/>+MaximumCapacity = 10<BR ALIGN="LEFT"/>+Charges: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+TryUse()<BR ALIGN="LEFT"/>+ResetForRest()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"items" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>PlayerConsumables</B></TD></TR><TR><TD ALIGN="LEFT">+Selected: ConsumableKind<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+TryUse(kind)<BR ALIGN="LEFT"/>+Equip(kind)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"catalog" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«ScriptableObject»</FONT><BR/><B>ConsumableCatalog</B></TD></TR><TR><TD ALIGN="LEFT">+items: Item[]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+Find(kind): Item<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"soul" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«static service»</FONT><BR/><B>SoulConsumption</B></TD></TR><TR><TD ALIGN="LEFT">+[static] Active / NextChancePercent<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+[static] OutgoingMultiplier(...)<BR ALIGN="LEFT"/>+[static] IncomingMultiplier(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"drops" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«static service»</FONT><BR/><B>World.PlayerDeathDrops</B></TD></TR><TR><TD ALIGN="LEFT">+[static] OnDeath(player)<BR ALIGN="LEFT"/>+[static] Refresh()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"pickup" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«WorldInteractable subclass»</FONT><BR/><B>World.PlayerDeathDropPickup</B></TD></TR><TR><TD ALIGN="LEFT">+DropId: string<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">#Interact(player)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"defeat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«static service»</FONT><BR/><B>EnemyDefeatState</B></TD></TR><TR><TD ALIGN="LEFT">+[static] WasDefeated(id)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"bossinv" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«static service»</FONT><BR/><B>BossItemInventory</B></TD></TR><TR><TD ALIGN="LEFT">+[static] TryGrant(...)<BR ALIGN="LEFT"/>+[static] OwnedItems()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"prefs" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«Unity API»</FONT><BR/><B>UnityEngine.PlayerPrefs</B></TD></TR><TR><TD ALIGN="LEFT">+[static] GetString(...)<BR ALIGN="LEFT"/>+[static] SetString(...) / Save()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"cp" -> "menu" [arrowhead=vee, label="mở menu"];
"cp" -> "service" [style=dashed, arrowhead=vee, label="lưu / mở tượng"];
"menu" -> "service" [style=dashed, arrowhead=vee, label="du hành / ghi nhớ tượng"];
"service" -> "record" [arrowhead=vee, label="pending / fallback"];
"service" -> "fade" [style=dashed, arrowhead=vee, label="chuyển cảnh / fade"];
