"menu" -> "eco" [style=dashed, arrowhead=vee, label="nâng cấp / hiến tế / thanh tẩy"];
"menu" -> "potion" [style=dashed, arrowhead=vee, label="hồi bình máu"];
"eco" -> "settings" [arrowhead=vee, label="đọc giá / thưởng"];
"prog" -> "eco" [style=dashed, arrowhead=vee, label="nghe Changed"];
"items" -> "catalog" [arrowhead=vee, label="đọc hiệu ứng / icon"];
"items" -> "eco" [style=dashed, arrowhead=vee, label="quản lý ô dùng nhanh"];
"items" -> "service" [style=dashed, arrowhead=vee, label="Bùa hồi quy"];
"soul" -> "eco" [style=dashed, arrowhead=vee, label="trạng thái nhiễm / thưởng"];
"drops" -> "eco" [style=dashed, arrowhead=vee, label="ghi khoản rơi 50%"];
"drops" -> "pickup" [style=dashed, arrowhead=vee, label="tạo điểm thu hồi"];
"pickup" -> "eco" [style=dashed, arrowhead=vee, label="thu hồi khoản rơi"];
"eco" -> "prefs" [style=dashed, arrowhead=vee, label="JSON / PlayerPrefs"];
