digraph UML { graph [rankdir=TB, bgcolor="white", fontname="Arial", fontsize=19, label="Hình 4. Class Diagram — điều khiển và chiến đấu", labelloc=t, pad="0.28", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst, ordering=out]; node [fontname="Arial", fontsize=13, color="#263442"]; edge [fontname="Arial", fontsize=10, color="#526170", arrowsize=.7];
"controller" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>PlayerController</B></TD></TR><TR><TD ALIGN="LEFT">+moveSpeed: float<BR ALIGN="LEFT"/>+IsSprinting: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+StopSprinting()<BR ALIGN="LEFT"/>+DelayStaminaRecovery()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"dash" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>PlayerDash</B></TD></TR><TR><TD ALIGN="LEFT">+dashDuration: float<BR ALIGN="LEFT"/>+dashStaminaCost: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+TryDash(inputDirection)<BR ALIGN="LEFT"/>+CancelDash()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"pc" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>PlayerCombat</B></TD></TR><TR><TD ALIGN="LEFT">+normalAttackSkillName: string<BR ALIGN="LEFT"/>+skill2SkillName: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"parry" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>CharacterParry</B></TD></TR><TR><TD ALIGN="LEFT">+isParrying: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+EnableParryWindow()<BR ALIGN="LEFT"/>+ExecuteParry(attacker)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"stats" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>CharacterStats</B></TD></TR><TR><TD ALIGN="LEFT">+maxHP / currentHP: float<BR ALIGN="LEFT"/>+maxStamina / currentStamina: float<BR ALIGN="LEFT"/>+ATK / DEF / STR: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+AddPosture(amount)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"health" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>CharacterHealth</B></TD></TR><TR><TD ALIGN="LEFT">+isDead: bool<BR ALIGN="LEFT"/>+[static] AnyDied: event<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+TakeDamage(...)<BR ALIGN="LEFT"/>+Heal(amount)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"mgr" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>SkillDamageManager</B></TD></TR><TR><TD ALIGN="LEFT">+skills: List&lt;SkillData&gt;<BR ALIGN="LEFT"/>+targetLayer: LayerMask<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+MarkSkillUsed(skillName)<BR ALIGN="LEFT"/>+ExecuteHit(skillName)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"skill" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«Serializable»</FONT><BR/><B>SkillData</B></TD></TR><TR><TD ALIGN="LEFT">+skillName: string<BR ALIGN="LEFT"/>+damageMultiplier: float<BR ALIGN="LEFT"/>+cooldownTime: float<BR ALIGN="LEFT"/>+attackRange: float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ai" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>EnemyBehavior</B></TD></TR><TR><TD ALIGN="LEFT">+currentState: OrcState<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+IsInCombatWith(target)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"aware" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>EnemyAwareness</B></TD></TR><TR><TD ALIGN="LEFT">+maxChaseDistance: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+HasLineOfSight(target)<BR ALIGN="LEFT"/>+MaxAlert()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ec" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>EnemyCombat</B></TD></TR><TR><TD ALIGN="LEFT">+skillManager: SkillDamageManager<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+TriggerAttack(...)<BR ALIGN="LEFT"/>+TriggerSkill(...)<BR ALIGN="LEFT"/>#ShouldLunge(skill): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"break" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>EnemyBreak</B></TD></TR><TR><TD ALIGN="LEFT">+recoveryDelay: float<BR ALIGN="LEFT"/>+IsBroken / Ratio<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ReceiveHit(staminaDamage)<BR ALIGN="LEFT"/>+ClearBreak()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"phase" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>BossPhaseController</B></TD></TR><TR><TD ALIGN="LEFT">+phase1Skills / phase2Skills<BR ALIGN="LEFT"/>+IsTransitioning: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+AllowsSkill(skill)<BR ALIGN="LEFT"/>+EvaluatePhase()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"director" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«MonoBehaviour»</FONT><BR/><B>BossMovesetDirector</B></TD></TR><TR><TD ALIGN="LEFT">+combos: List&lt;Combo&gt;<BR ALIGN="LEFT"/>+ObservedMove: PlayerMove<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+SelectOpening(...)<BR ALIGN="LEFT"/>+OnSkillStarted(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SlimeCombat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«EnemyCombat subclass»</FONT><BR/><B>SlimeCombat</B></TD></TR></TABLE>>];
"WerebearCombat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«EnemyCombat subclass»</FONT><BR/><B>WerebearCombat</B></TD></TR></TABLE>>];
"WerewolfCombat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«EnemyCombat subclass»</FONT><BR/><B>WerewolfCombat</B></TD></TR></TABLE>>];
"OrcRiderCombat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«EnemyCombat subclass»</FONT><BR/><B>OrcRiderCombat</B></TD></TR></TABLE>>];
"NecromancerCombat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«EnemyCombat subclass»</FONT><BR/><B>NecromancerCombat</B></TD></TR></TABLE>>];
"BlackKnightCombat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«EnemyCombat subclass»</FONT><BR/><B>BlackKnightCombat</B></TD></TR></TABLE>>];
"BlackKnightBossCombat" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#eef2f5"><FONT POINT-SIZE="11">«EnemyCombat subclass»</FONT><BR/><B>BlackKnightBossCombat</B></TD></TR></TABLE>>];
"controller" -> "dash" [arrowhead=vee, label="điều khiển dash"];
"dash" -> "stats" [arrowhead=vee, label="tiêu hao stamina"];
"pc" -> "mgr" [arrowhead=vee, label="gọi kỹ năng"];
"parry" -> "break" [style=dashed, arrowhead=vee, label="đỡ đòn → sát thương choáng"];
"health" -> "stats" [arrowhead=vee, label="đọc / cập nhật HP"];
"health" -> "break" [arrowhead=vee, label="chuyển sát thương choáng"];
"mgr" -> "skill" [dir=both, arrowtail=diamond, arrowhead=none, label="skills · 0..*"];
"mgr" -> "stats" [arrowhead=vee, label="tính sát thương"];
"mgr" -> "health" [style=dashed, arrowhead=vee, label="gây sát thương mục tiêu"];
"ai" -> "aware" [arrowhead=vee, label="nhận biết / LOS"];
"ai" -> "ec" [arrowhead=vee, label="ra lệnh tấn công"];
"ec" -> "mgr" [arrowhead=vee, label="thực thi kỹ năng"];
"ec" -> "phase" [style=dashed, arrowhead=vee, label="lọc chiêu theo phase"];
"ec" -> "director" [style=dashed, arrowhead=vee, label="chọn đòn / combo"];
"break" -> "stats" [arrowhead=vee, label="hồi thanh choáng"];
"ec" -> "SlimeCombat" [dir=back, arrowtail=empty, arrowhead=none];
"ec" -> "WerebearCombat" [dir=back, arrowtail=empty, arrowhead=none];
"ec" -> "WerewolfCombat" [dir=back, arrowtail=empty, arrowhead=none];
"ec" -> "OrcRiderCombat" [dir=back, arrowtail=empty, arrowhead=none];
"ec" -> "NecromancerCombat" [dir=back, arrowtail=empty, arrowhead=none];
"ec" -> "BlackKnightCombat" [dir=back, arrowtail=empty, arrowhead=none];
"ec" -> "BlackKnightBossCombat" [dir=back, arrowtail=empty, arrowhead=none];
}